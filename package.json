{
  "name": "openos",
  "version": "0.1.0",
  "private": true,
  "description": "OpenOS — a web desktop you build by source: kernel, VFS, DE",
  "author": "Bibobonking <bibobonking@gmail.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/kernel/vfs.test.ts src/os/appFrame.test.ts",
    "desktop": "vite build && electron .",
    "pack": "vite build && electron-builder --publish never"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "build": {
    "appId": "dev.opensoftx.openos",
    "productName": "OpenOS",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    },
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools"
    }
  }
}